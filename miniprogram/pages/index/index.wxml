<view class="container">
<swiper indicator-dots autoplay interval="4000" circular style="height:380rpx;border-radius:20rpx;overflow:hidden;margin-bottom:24rpx">
<swiper-item style="background:linear-gradient(135deg,#1b4d89,#2a5d99);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40rpx">
<text style="font-size:36rpx;color:#fff;font-weight:700;text-align:center;margin-bottom:12rpx">欢迎来到\n中山大学中山眼科中心茂名医院</text>
<text style="font-size:26rpx;color:rgba(255,255,255,.85);text-align:center;margin-bottom:24rpx">国家级眼科平台落户茂名</text>
<text class="motto-text" style="font-size:40rpx;color:rgba(255,255,255,.9)">善良 · 求真 · 创新</text>
</swiper-item>
<swiper-item style="background:linear-gradient(135deg,#163e6e,#1b4d89);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40rpx">
<text style="font-size:36rpx;color:#fff;font-weight:700;text-align:center;margin-bottom:12rpx">专家团队</text>
<text style="font-size:26rpx;color:rgba(255,255,255,.85);text-align:center">中山眼科中心专家定期坐诊</text>
<text class="motto-text" style="font-size:40rpx;color:rgba(255,255,255,.9);margin-top:20rpx">善良 · 求真 · 创新</text>
</swiper-item>
<swiper-item style="background:linear-gradient(135deg,#0f2f55,#163e6e);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40rpx">
<text style="font-size:36rpx;color:#fff;font-weight:700;text-align:center;margin-bottom:12rpx">先进设备</text>
<text style="font-size:26rpx;color:rgba(255,255,255,.85);text-align:center">全飞秒激光、OCT、超声乳化仪等</text>
<text class="motto-text" style="font-size:40rpx;color:rgba(255,255,255,.9);margin-top:20rpx">善良 · 求真 · 创新</text>
</swiper-item>
</swiper>

<view class="st">快速服务</view>
<view class="g2">
<view class="g2-item" bindtap="goService"><view class="g2c"><view class="g2c-icon">📅</view><view class="g2c-text">在线预约挂号</view></view></view>
<view class="g2-item" bindtap="goDoctors"><view class="g2c"><view class="g2c-icon">👨‍⚕️</view><view class="g2c-text">专家出诊时间</view></view></view>
<view class="g2-item" bindtap="goGuide"><view class="g2c"><view class="g2c-icon">🗺️</view><view class="g2c-text">科室导航图</view></view></view>
<view class="g2-item" bindtap="goGuide"><view class="g2c"><view class="g2c-icon">📋</view><view class="g2c-text">就诊流程指引</view></view></view>
<view class="g2-item" bindtap="goFaq"><view class="g2c"><view class="g2c-icon">❓</view><view class="g2c-text">常见问题解答</view></view></view>
<view class="g2-item" bindtap="goFees"><view class="g2c"><view class="g2c-icon">💰</view><view class="g2c-text">费用查询</view></view></view>
</view>

<view class="st">特色医疗</view>
<scroll-view scroll-x class="mb30" style="white-space:nowrap">
<view style="display:inline-block;margin-right:16rpx;width:260rpx" wx:for="{{depts}}" wx:key="name" bindtap="goDept" class="dept-card {{item.hl?'hl':''}}" style="display:inline-block">
<view style="font-size:44rpx;text-align:center;margin-bottom:12rpx">{{item.icon}}</view>
<view class="dept-name" style="text-align:center">{{item.name}}</view>
<view class="dept-floor" style="text-align:center">{{item.floor}}</view>
</view>
</scroll-view>

<view class="st">医院动态</view>
<view class="card mb20" wx:for="{{news}}" wx:key="title" style="display:flex;gap:16rpx;align-items:flex-start">
<view style="background:var(--p);color:#fff;padding:8rpx 16rpx;border-radius:12rpx;font-size:24rpx;font-weight:700;flex-shrink:0">{{item.date}}</view>
<view><view style="font-size:28rpx;font-weight:600;margin-bottom:4rpx">{{item.title}}</view><view style="font-size:24rpx;color:var(--tl)">{{item.desc}}</view></view>
</view>
</view>

<view class="ai-fab" bindtap="openAI">💬</view>
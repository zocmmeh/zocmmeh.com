<view class="container">
<view class="st">在线预约挂号</view>
<view class="card">
<view class="form-group"><view class="form-label">选择科室</view>
<picker mode="selector" range="{{depts}}" bindchange="onDept"><view class="form-input">{{depts[di]||'请选择科室'}}</view></picker></view>
<view class="form-group"><view class="form-label">选择医生</view>
<picker mode="selector" range="{{docs}}" bindchange="onDoc"><view class="form-input">{{docs[docI]||'请选择医生'}}</view></picker></view>
<view class="form-group"><view class="form-label">预约日期</view>
<picker mode="date" bindchange="onDate"><view class="form-input">{{date||'请选择日期'}}</view></picker></view>
<view class="form-group"><view class="form-label">预约时段</view>
<picker mode="selector" range="{{times}}" bindchange="onTime"><view class="form-input">{{times[ti]||'请选择时段'}}</view></picker></view>
<view class="form-group"><view class="form-label">姓名</view><input class="form-input" placeholder="请输入姓名" bindinput="onName"/></view>
<view class="form-group"><view class="form-label">手机号</view><input class="form-input" type="number" placeholder="请输入手机号" bindinput="onPhone"/></view>
<button class="btn-p" style="margin-top:16rpx" bindtap="submit">提交预约</button>
</view>

<view class="st">缴费方式</view>
<view class="g2">
<view class="g2-item"><view class="g2c"><view class="g2c-icon">🏋</view><view class="g2c-text">自费缴费</view><view style="font-size:22rpx;color:var(--tl)">微信/支付宝/现金</view></view></view>
<view class="g2-item"><view class="g2c"><view class="g2c-icon">🉎</view><view class="g2c-text">医保结算</view><view style="font-size:22rpx;color:var(--tl)">窗口刷卡办理</view></view></view>
<view class="g2-item"><view class="g2c"><view class="g2c-icon">📱</view><view class="g2c-text">在线缴费</view><view style="font-size:22rpx;color:var(--tl)">公众号内完成</view></view></view>
<view class="g2-item"><view class="g2c"><view class="g2c-icon">📒</view><view class="g2c-text">发票打印</view><view style="font-size:22rpx;color:var(--tl)">一楼自助机</view></view></view>
</view>
</view>
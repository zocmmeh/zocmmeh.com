page{--p:#1b4d89;--pd:#163e6e;--pl:#2a5d99;--a:#fc802f;--al:#fdbf97;--bl:#6995c4;--bg:#f5f7fa;--w:#fff;--t:#333;--tl:#666;--bd:#e0e0e0;--r:20rpx;--sh:0 4rpx 24rpx rgba(0,0,0,.08);font-size:28rpx;color:var(--t);background:var(--bg);line-height:1.6;font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif}
.container{padding:24rpx}
.st{font-size:34rpx;font-weight:700;color:var(--p);margin:32rpx 0 20rpx;padding-left:18rpx;border-left:8rpx solid var(--a)}
.card{background:var(--w);border-radius:var(--r);padding:28rpx;box-shadow:var(--sh);margin-bottom:20rpx}
.btn-p{background:var(--p);color:var(--w);border-radius:50rpx;font-size:30rpx;font-weight:600;padding:20rpx 0}
.btn-p:active{opacity:.85}
.btn-a{background:var(--a);color:var(--w);border-radius:50rpx;font-size:30rpx;font-weight:600;padding:20rpx 0}
.btn-a:active{opacity:.85}
.mb20{margin-bottom:20rpx}
.mb30{margin-bottom:30rpx}

/* Quick grid */
.g2{display:flex;flex-wrap:wrap;margin:0 -10rpx}
.g2-item{width:50%;padding:10rpx;box-sizing:border-box}
.g2c{background:var(--w);border-radius:var(--r);padding:28rpx 16rpx;text-align:center;box-shadow:var(--sh)}
.g2c-icon{font-size:52rpx;margin-bottom:12rpx}
.g2c-text{font-size:26rpx;color:var(--p);font-weight:600}

/* Dept cards */
.dept-card{background:var(--w);border-radius:var(--r);padding:28rpx;margin-bottom:20rpx;box-shadow:var(--sh);border-left:8rpx solid var(--p)}
.dept-card.hl{border-left-color:var(--a);background:linear-gradient(135deg,#fffaf5,#fff);border-width:4rpx;border-style:solid;border-color:var(--a);border-left-width:8rpx}
.dept-name{font-size:32rpx;font-weight:700;color:var(--p);margin-bottom:8rpx}
.dept-floor{font-size:24rpx;color:var(--a);margin-bottom:16rpx}
.dept-h4{font-size:28rpx;color:var(--pd);margin:16rpx 0 8rpx;font-weight:600}
.dept-list{padding-left:20rpx}
.dept-li{font-size:26rpx;color:var(--tl);padding:4rpx 0;position:relative}
.dept-li::before{content:"•";color:var(--a);position:absolute;left:-18rpx;font-weight:700}

/* Alert box */
.alert-red{background:#fff5f5;border-left:8rpx solid #dc3545;padding:20rpx 24rpx;border-radius:12rpx;margin-bottom:20rpx}
.alert-red text{font-size:26rpx;color:#cc3300}

/* Doctor card */
.doc-card{background:var(--w);border-radius:var(--r);padding:28rpx;margin-bottom:20rpx;box-shadow:var(--sh);display:flex;gap:20rpx;align-items:flex-start}
.doc-avatar{width:100rpx;height:100rpx;border-radius:50%;background:linear-gradient(135deg,var(--p),var(--bl));display:flex;align-items:center;justify-content:center;color:var(--w);font-size:40rpx;flex-shrink:0}
.doc-name{font-size:30rpx;font-weight:700;margin-bottom:4rpx}
.doc-title{font-size:24rpx;color:var(--p);margin-bottom:10rpx}
.doc-exp{font-size:26rpx;color:var(--tl);line-height:1.5;margin-bottom:10rpx}
.doc-sched{font-size:24rpx;color:var(--a);font-weight:600;background:var(--bg);padding:6rpx 16rpx;border-radius:10rpx;display:inline-block}

/* Floor nav */
.floor-group{margin-bottom:24rpx}
.floor-label{font-size:26rpx;color:var(--tl);padding:10rpx 20rpx;background:var(--bg);border-radius:12rpx;margin-bottom:12rpx}
.floor-grid{display:flex;flex-wrap:wrap;margin:0 -8rpx}
.floor-item{width:50%;padding:8rpx;box-sizing:border-box}
.floor-box{background:var(--w);border-radius:16rpx;padding:20rpx;box-shadow:var(--sh);border-left:8rpx solid var(--p)}
.floor-box.gn{border-left-color:#28a745}.floor-box.or{border-left-color:var(--a)}.floor-box.yl{border-left-color:#ffc107}.floor-box.gy{border-left-color:#adb5bd}
.floor-box.star{background:linear-gradient(135deg,#fffaf5,#fff);border-left-color:var(--a)}
.floor-box.vip{border:3rpx solid #b8860b;background:linear-gradient(135deg,#fffbf0,#fff)}
.floor-num{font-size:30rpx;font-weight:800;color:var(--p);margin-bottom:6rpx}
.floor-title{font-size:26rpx;font-weight:700;margin-bottom:6rpx}
.floor-desc{font-size:22rpx;color:var(--tl);line-height:1.4}

/* Steps */
.step{display:flex;gap:16rpx;margin-bottom:24rpx;align-items:flex-start}
.step-num{width:56rpx;height:56rpx;border-radius:50%;background:var(--p);color:var(--w);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:28rpx;flex-shrink:0}
.step-h4{font-size:28rpx;color:var(--p);margin-bottom:4rpx}
.step-p{font-size:24rpx;color:var(--tl)}
.arr-down{text-align:center;color:var(--a);font-size:36rpx;margin:8rpx 0}

/* FAQ */
.faq-item{background:var(--w);border-radius:var(--r);margin-bottom:12rpx;overflow:hidden}
.faq-q{padding:24rpx 28rpx;display:flex;justify-content:space-between;align-items:center;font-size:28rpx;font-weight:600}
.faq-a{padding:0 28rpx 24rpx;font-size:26rpx;color:var(--tl);line-height:1.7}

/* Table */
.tbl-wrap{overflow-x:auto;margin-bottom:24rpx;border-radius:var(--r);overflow:hidden}
.tbl{width:100%;border-collapse:collapse;font-size:26rpx}
.tbl th{background:var(--p);color:var(--w);padding:18rpx 20rpx;text-align:left;font-weight:600;white-space:nowrap}
.tbl td{padding:14rpx 20rpx;border-bottom:1rpx solid var(--bd);color:var(--tl);background:var(--w)}
.tbl tr:nth-child(even) td{background:var(--bg)}

/* AI Console */
.ai-fab{position:fixed;bottom:40rpx;right:40rpx;width:100rpx;height:100rpx;border-radius:50%;background:var(--a);color:var(--w);font-size:48rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 8rpx 32rpx rgba(252,128,47,.4);z-index:999}
.ai-panel{position:fixed;bottom:0;left:0;right:0;max-height:85vh;background:var(--w);border-radius:40rpx 40rpx 0 0;z-index:1000;box-shadow:0 -8rpx 40rpx rgba(0,0,0,.15)}
.ai-tabs{display:flex;overflow-x:auto;border-bottom:1rpx solid var(--bd);padding:0 16rpx}
.ai-tab{padding:20rpx 24rpx;font-size:26rpx;color:var(--tl);white-space:nowrap;border-bottom:4rpx solid transparent}
.ai-tab.active{color:var(--p);border-bottom-color:var(--p);font-weight:700}
.ai-body{padding:24rpx;max-height:60vh;overflow-y:auto}
.ai-hint{font-size:26rpx;color:var(--tl);margin-bottom:16rpx}
.ai-textarea{width:100%;height:160rpx;border:1rpx solid var(--bd);border-radius:12rpx;padding:16rpx;font-size:28rpx;margin-bottom:16rpx}
.ai-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}
.ai-tag{background:var(--bg);padding:10rpx 20rpx;border-radius:30rpx;font-size:24rpx}

/* About */
.hero-bl{background:linear-gradient(135deg,var(--p),var(--pl));color:var(--w);padding:48rpx 32rpx;border-radius:var(--r);text-align:center;margin-bottom:28rpx}
.hero-bl .h1{font-size:36rpx;font-weight:700;margin-bottom:12rpx}
.hero-bl .p{font-size:26rpx;opacity:.85}
.date-card{background:#f0f7ff;border-left:8rpx solid var(--p);padding:24rpx 28rpx;border-radius:12rpx;margin-bottom:28rpx}
.date-card text{font-size:28rpx;margin:6rpx 0}
.motto-box{text-align:center;padding:48rpx;margin:28rpx 0;background:linear-gradient(135deg,#f0f7ff,#fffaf5);border-radius:var(--r)}
.motto-text{font-size:52rpx;color:var(--p);letter-spacing:.4em;font-weight:700}

/* Service form */
.form-group{margin-bottom:24rpx}
.form-label{font-size:28rpx;font-weight:600;margin-bottom:10rpx}
.form-input{padding:20rpx;border:1rpx solid var(--bd);border-radius:12rpx;font-size:28rpx;width:100%}
.form-picker{width:100%}

/* Admin modal */
.admin-mask{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10000;display:flex;align-items:center;justify-content:center}
.admin-modal{background:var(--w);padding:48rpx;border-radius:24rpx;width:80%}
.admin-input{border:1rpx solid var(--bd);border-radius:12rpx;padding:20rpx;font-size:30rpx;width:100%;margin-bottom:24rpx}
.admin-btns{display:flex;gap:16rpx}
.admin-btns button{flex:1;padding:16rpx;border-radius:12rpx;font-size:28rpx;font-weight:600}
.admin-cancel{background:var(--bg);color:var(--t)}
.admin-confirm{background:var(--p);color:var(--w)}
